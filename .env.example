# Copy to .env and adjust if your local ports differ.
# No exchange API key is required: Binance public market-data streams are unauthenticated.

DATABASE_URL="postgresql://blockwatch:blockwatch@localhost:5432/blockwatch?schema=public"
# 6380, not 6379, to avoid colliding with a Redis already running on the host.
REDIS_URL="redis://localhost:6380"

# api-server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# frontend (must be NEXT_PUBLIC_ to reach the browser; these are URLs, never secrets)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"
